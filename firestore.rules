rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true; }
    function activeSeller() { return signedIn() && exists(/databases/$(database)/documents/sellers/$(request.auth.uid)) && get(/databases/$(database)/documents/sellers/$(request.auth.uid)).data.status == 'active'; }

    match /admins/{uid} { allow read: if owner(uid); allow write: if false; }
    match /users/{uid} { allow read, create, update: if owner(uid); allow delete: if false; match /addresses/{id} { allow read, write: if owner(uid); } match /fcmTokens/{id} { allow read, write: if false; } }
    match /sellers/{uid} { allow read: if owner(uid) || admin(); allow create: if owner(uid) && request.resource.data.ownerId == request.auth.uid && request.resource.data.status == 'active'; allow update: if owner(uid) && request.resource.data.ownerId == resource.data.ownerId && request.resource.data.status == resource.data.status; allow delete: if admin(); }
    match /products/{id} {
      allow read: if (resource.data.active == true && resource.data.approvalStatus == 'approved') || (signedIn() && resource.data.sellerId == request.auth.uid) || admin();
      allow create: if activeSeller() && request.resource.data.sellerId == request.auth.uid && request.resource.data.active == false && request.resource.data.approvalStatus == 'pending';
      allow update: if admin() || (activeSeller() && resource.data.sellerId == request.auth.uid && request.resource.data.sellerId == resource.data.sellerId && request.resource.data.active == false && request.resource.data.approvalStatus == 'pending');
      allow delete: if admin();
    }
    match /orders/{id} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.status == 'placed' && request.resource.data.paymentStatus == 'pending' && request.resource.data.total is number && request.resource.data.total >= 0;
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || request.auth.uid in resource.data.sellerIds) || admin();
      allow update: if admin() || (signedIn() && resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','statusHistory','updatedAt']) && resource.data.status in ['placed','confirmed'] && request.resource.data.status == 'cancelled') || (signedIn() && request.auth.uid in resource.data.sellerIds && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sellerFulfilments','updatedAt']));
      allow delete: if false;
    }
    match /reviews/{id} { allow read: if resource.data.moderationStatus == 'published' || admin() || (signedIn() && resource.data.userId == request.auth.uid); allow create, update: if signedIn() && id == request.auth.uid + '_' + request.resource.data.productId && request.resource.data.userId == request.auth.uid && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5; allow delete: if admin(); }
    match /conversations/{id} { allow read: if signedIn() && request.auth.uid in resource.data.participantIds || admin(); allow create: if signedIn() && request.auth.uid in request.resource.data.participantIds; allow update: if signedIn() && request.auth.uid in resource.data.participantIds || admin(); allow delete: if false; match /messages/{mid} { allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(id)).data.participantIds || admin(); allow create: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(id)).data.participantIds && request.resource.data.senderId == request.auth.uid; allow update, delete: if false; } }
    match /notifications/{id} { allow read: if signedIn() && resource.data.userId == request.auth.uid; allow update: if signedIn() && resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']); allow create, delete: if false; }
    match /promotions/{id} { allow read: if resource.data.status == 'active' || admin(); allow write: if false; }
    match /supportCases/{id} { allow read: if signedIn() && request.auth.uid in resource.data.participantIds || admin(); allow write: if false; }
    match /sellerLedger/{id} { allow read: if signedIn() && resource.data.sellerId == request.auth.uid || admin(); allow write: if false; }
    match /financeLedger/{id} { allow read: if admin(); allow write: if false; }
    match /paymentIntents/{id} { allow read, write: if false; }
    match /analyticsEvents/{id} { allow read, write: if false; }
  }
}
